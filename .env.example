# Backend Environment Variables
NODE_ENV=production
PORT=5000

# MongoDB Configuration
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/workconnect?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Redis (For WebRTC/Socket.io Streams and Scaling)
USE_REDIS=true
REDIS_URI=redis://127.0.0.1:6379

# LiveKit WebRTC Configuration
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_WS_URL=wss://your-project.livekit.cloud

# File Storage Configuration (Cloudinary / S3 / Local)
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Service (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=noreply@workconnect.com

# Client Application URL
CLIENT_URL=https://your-workconnect-domain.com

# ==========================================
# Frontend Environment Variables (client/.env)
# ==========================================
VITE_API_URL=https://api.your-workconnect-domain.com
